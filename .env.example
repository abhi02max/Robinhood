# ============================================
# ROBINHOOD - ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================
# Copy this file to create your own configuration:
#   Root:    .env (infrastructure only)
#   AI:      scratch/.env (AI keys and models)
#   Local:   scratch/.env.local (local dev URLs)
# ============================================

# ==========================================
# FILE: .env (root - infrastructure)
# ==========================================
COMPOSE_PROJECT_NAME=robinhood
POSTGRES_PORT=5433
REDIS_PORT=6379
OLLAMA_PORT=11434
BACKEND_PORT=3000
FRONTEND_PORT=5173
POSTGRES_USER=robinhood
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=robinhood

# Backend hardening defaults
TRUST_PROXY=1
CORS_ALLOW_ORIGINS=https://app.example.com,https://www.app.example.com
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_AUTH_MAX=40
API_RATE_LIMIT_EXEC_MAX=80

# Local execution failover configuration
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_API_URL=http://127.0.0.1:2358

# ==========================================
# FILE: scratch/.env (AI configuration)
# ==========================================
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=qwen/qwen3.6-plus:free
OLLAMA_MODEL=qwen2.5-coder:3b
AI_TIMEOUT_MS=18000
AI_MIN_INTERVAL_MS=4000
AI_CACHE_TTL_MS=600000
AI_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_WINDOW_SECONDS=30
AI_DAILY_REQUEST_LIMIT=100
AI_GLOBAL_CONCURRENCY_LIMIT=8
PISTON_TIMEOUT_MS=10000

# ==========================================
# FILE: scratch/.env.local (local dev URLs)
# ==========================================
DATABASE_URL=postgresql://robinhood:change_me_secure_password@127.0.0.1:5433/robinhood
REDIS_URL=redis://127.0.0.1:6379
OLLAMA_URL=http://127.0.0.1:11434
PISTON_URL=http://127.0.0.1:2000/api/v2/execute
SQL_SANDBOX_URL=postgresql://robinhood:change_me_secure_password@127.0.0.1:5433/robinhood
PORT=3000

# Code execution provider: paiza | judge0 | piston | mock
#
# Set this explicitly. The engine's built-in default is `piston`, whose free
# public API closed on 2026-02-15, so leaving it unset fails with a confusing 401.
#
#   paiza   free and hosted, api_key=guest, no signup. CPU is capped at 1.00s and
#           a caller cannot raise it, so a slow-but-correct solution is reported
#           as Time Limit Exceeded.
#   judge0  needs a paid RapidAPI key (cheapest documented tier is EUR 27/month)
#           or a self-hosted instance.
#   piston  self-hosted only.
#   mock    offline/CI only -- reports a FAKE pass for any non-empty code. Never
#           point a deployment users can reach at this.
#
# Only the selected provider is probed by /api/health/ready; the others report
# 'skipped'. List them in OPTIONAL_DEPENDENCIES so an outage is a warning rather
# than a 503 that makes a host restart the whole app.
EXECUTION_PROVIDER=paiza
PAIZA_URL=https://api.paiza.io
PAIZA_API_KEY=guest
PAIZA_POLL_INTERVAL_MS=500
PAIZA_MAX_POLLS=20
OPTIONAL_DEPENDENCIES=redis,piston,judge0,paiza

# Judge0 (only used when EXECUTION_PROVIDER=judge0). Never commit a real key.
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_BATCH_SIZE=20
JUDGE0_POLL_INTERVAL_MS=400
JUDGE0_MAX_POLLS=40

# Applies to piston and judge0. Paiza ignores it -- its 1.00s cap is fixed.
EXECUTION_TIMEOUT_MS=5000
