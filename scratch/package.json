{
  "name": "scratch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/ensure-build-safe.mjs && node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "next dev -p 5173",
    "dev:vite": "vite",
    "server": "node server/index.js",
    "seed:learning": "node server/scripts/seed-learning.js",
    "check:starters": "node server/scripts/check-starters.js --language all",
    "check:java-starters": "node server/scripts/check-starters.js --language java",
    "check:cpp-starters": "node server/scripts/check-starters.js --language cpp",
    "check:authored": "node server/scripts/check-authored-problems.js",
    "verify:journeys": "node scripts/verify-journeys.mjs",
    "start": "next start -p 5173",
    "predev:all": "npx --yes kill-port 3000 5173",
    "dev:all": "concurrently --names api,web --prefix \"[{name}]\" --success all --kill-others-on-fail \"node server/index.js\" \"next dev -p 5173\"",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:flows": "node scripts/smoke-flows.mjs",
    "gate:regression": "node scripts/gate/static-data-scan.mjs",
    "gate:release": "node scripts/release-gate-final.mjs",
    "qa:optional": "node scripts/qa-optional.mjs",
    "qa:full": "npm run smoke:routes && npm run smoke:api && npm run smoke:flows",
    "hardening:edge": "node scripts/hardening-edge-cases.mjs",
    "hardening:soak": "node scripts/hardening-soak-session.mjs",
    "hardening:load": "node scripts/hardening-concurrency.mjs",
    "hardening:prod": "node scripts/hardening-production-check.mjs",
    "hardening:final": "node scripts/hardening-final-report.mjs",
    "lint": "eslint src server --ignore-pattern server/data --ignore-pattern src/data",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --test tests/unit/**/*.test.js",
    "test:e2e": "playwright test",
    "build": "next build",
    "build:docker": "next build --no-lint",
    "build:vite": "tsc && vite build",
    "preview": "next start -p 5173",
    "preview:vite": "vite preview"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.54.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "nodemon": "^3.1.14",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.2.4",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.8.0",
    "next": "^15.4.0",
    "pg": "^8.13.1",
    "postcss": "^8.5.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "redis": "^4.7.0",
    "tailwindcss": "^4.2.4",
    "uuid": "^14.0.0",
    "zod": "^3.25.76"
  }
}
